<Page
    x:Class="RemoteDesktop.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="520">
            <TextBlock Text="Remote Desktop LAN" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock
                Text="同一Wi-Fi上のPCと画面共有・リモート操作を行います。"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                Opacity="0.8"
                TextAlignment="Center" />
            <Button Content="このPCをホストにする" Click="HostButton_Click" HorizontalAlignment="Stretch" Height="56" />
            <Button Content="別のPCに接続する" Click="ViewerButton_Click" HorizontalAlignment="Stretch" Height="56" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <TextBlock x:Name="VersionText" Opacity="0.6" VerticalAlignment="Center" />
                <Button Content="更新を確認" Click="CheckUpdateButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
