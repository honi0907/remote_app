<Page
    x:Class="RemoteDesktop.App.Views.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="戻る" Click="BackButton_Click" />
            <TextBlock Text="ホストモード" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="16" MaxWidth="640">
            <InfoBar
                x:Name="FirewallInfoBar"
                IsOpen="False"
                Severity="Informational"
                Title="ファイアウォール"
                Message="初回接続時は Windows ファイアウォールで Remote Desktop LAN の受信を許可してください。" />

            <Border Padding="24" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="PIN" Opacity="0.7" />
                    <TextBlock x:Name="PinText" FontSize="48" FontWeight="Bold" />
                    <TextBlock x:Name="HostNameText" Opacity="0.8" />
                    <TextBlock x:Name="IpText" Opacity="0.8" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="配信設定" FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="DeliveryModeComboBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="DeliveryModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="自動（H.264優先・JPEGフォールバック）" Tag="Auto" />
                        <ComboBoxItem Content="H.264（GPU）" Tag="H264" />
                        <ComboBoxItem Content="JPEG（互換モード）" Tag="Jpeg" />
                    </ComboBox>
                    <ComboBox
                        x:Name="PresetComboBox"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="PresetComboBox_SelectionChanged">
                        <ComboBoxItem Content="追従優先（FPS 24 / 1280px）" Tag="Responsive" />
                        <ComboBoxItem Content="画質優先（FPS 15 / フル解像度）" Tag="Quality" />
                        <ComboBoxItem Content="マニュアル" Tag="Manual" />
                    </ComboBox>
                    <StackPanel x:Name="ManualSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <NumberBox
                            x:Name="FpsNumberBox"
                            Header="FPS（10〜30）"
                            Minimum="10"
                            Maximum="30"
                            Value="24"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="ManualSetting_ValueChanged" />
                        <NumberBox
                            x:Name="MaxWidthNumberBox"
                            Header="最大幅（0 = フル解像度）"
                            Minimum="0"
                            Maximum="3840"
                            Value="1280"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="ManualSetting_ValueChanged" />
                        <NumberBox
                            x:Name="QualityNumberBox"
                            Header="JPEG 品質（30〜95）"
                            Minimum="30"
                            Maximum="95"
                            Value="55"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="ManualSetting_ValueChanged" />
                    </StackPanel>
                    <TextBlock x:Name="EffectiveSettingsText" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" />
            <TextBlock x:Name="ConnectedClientText" Opacity="0.8" />
            <TextBlock x:Name="FpsText" Opacity="0.8" Text="FPS: --" />

            <TextBlock
                Text="保護されたコンテンツ（一部の動画やセキュアデスクトップ）はキャプチャできない場合があります。"
                TextWrapping="Wrap"
                Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
