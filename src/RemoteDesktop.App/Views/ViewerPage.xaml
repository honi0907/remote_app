<Page
    x:Class="RemoteDesktop.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:protocol="using:RemoteDesktop.App.Protocol">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto" />
            <RowDefinition x:Name="DiagnosticRow" Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBar" Grid.Row="0" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="戻る" Click="BackButton_Click" />
            <TextBlock Grid.Column="2" Text="接続モード" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" x:Name="LatencyText" Text="遅延: --" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock Grid.Column="6" x:Name="FpsText" Text="FPS: --" VerticalAlignment="Center" Opacity="0.8" />
        </Grid>

        <StackPanel x:Name="DiagnosticBar" Grid.Row="1" Padding="16,0,16,8" Spacing="4">
            <TextBlock
                x:Name="DiagnosticText"
                TextWrapping="Wrap"
                FontWeight="SemiBold"
                Foreground="#E6B800"
                Text="診断: 未接続" />
            <TextBlock x:Name="LogPathText" Opacity="0.7" TextWrapping="Wrap" />
            <Button Content="ログフォルダを開く" Click="OpenLogFolder_Click" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel x:Name="ConnectionPanel" Padding="24" Spacing="16">
                <TextBlock x:Name="StatusText" Text="近傍ホストを探索中…" />
                <TextBlock Text="近傍のホスト" FontWeight="SemiBold" />
                <ListView
                    x:Name="HostListView"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="HostListView_ItemClick"
                    MinHeight="180">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="protocol:DiscoveredHost">
                            <StackPanel Padding="8">
                                <TextBlock Text="{x:Bind HostName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Address}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="手動接続 (同一PCテスト: 127.0.0.1)" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ManualAddressBox" PlaceholderText="IPアドレス" Text="127.0.0.1" />
                    <Button Grid.Column="2" Content="接続" Click="ManualConnectButton_Click" />
                </Grid>
            </StackPanel>

            <Grid x:Name="RemotePanel" Visibility="Collapsed">
                <Grid
                    x:Name="RemoteCanvas"
                    Background="Black"
                    IsTabStop="True"
                    PointerEntered="RemoteCanvas_PointerEntered"
                    PointerExited="RemoteCanvas_PointerExited"
                    PointerMoved="RemoteCanvas_PointerMoved"
                    PointerPressed="RemoteCanvas_PointerPressed"
                    PointerReleased="RemoteCanvas_PointerReleased"
                    PointerWheelChanged="RemoteCanvas_PointerWheelChanged">
                    <Image
                        x:Name="RemoteImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False" />
                </Grid>
                <Border
                    x:Name="RemoteOverlayBar"
                    VerticalAlignment="Top"
                    Background="#CC000000"
                    Visibility="Collapsed">
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Icon="Cancel" Label="切断" Click="DisconnectButton_Click" />
                        <AppBarButton Label="フル画面" Click="EnterFullscreenButton_Click" />
                    </CommandBar>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
