<Page
    x:Class="RemoteDesktop.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="戻る" Click="BackButton_Click" />
            <TextBlock Grid.Column="2" Text="接続モード" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" x:Name="LatencyText" Text="遅延: --" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock Grid.Column="6" x:Name="FpsText" Text="FPS: --" VerticalAlignment="Center" Opacity="0.8" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel x:Name="ConnectionPanel" Padding="24" Spacing="16">
                <TextBlock x:Name="StatusText" Text="近傍ホストを探索中…" />
                <TextBlock Text="近傍のホスト" FontWeight="SemiBold" />
                <ListView
                    x:Name="HostListView"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="HostListView_ItemClick"
                    MinHeight="180">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8">
                                <TextBlock Text="{Binding HostName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Address}" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="手動接続 (同一PCテスト: 127.0.0.1)" FontWeight="SemiBold" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ManualAddressBox" PlaceholderText="IPアドレス" Text="127.0.0.1" />
                    <Button Grid.Column="2" Content="接続" Click="ManualConnectButton_Click" />
                </Grid>
            </StackPanel>

            <Grid x:Name="RemotePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <CommandBar DefaultLabelLocation="Right">
                    <AppBarButton Icon="Cancel" Label="切断" Click="DisconnectButton_Click" />
                </CommandBar>
                <Grid
                    x:Name="RemoteCanvas"
                    Grid.Row="1"
                    Background="Black"
                    Focusable="True"
                    KeyDown="RemoteCanvas_KeyDown"
                    KeyUp="RemoteCanvas_KeyUp"
                    PointerMoved="RemoteCanvas_PointerMoved"
                    PointerPressed="RemoteCanvas_PointerPressed"
                    PointerReleased="RemoteCanvas_PointerReleased"
                    PointerWheelChanged="RemoteCanvas_PointerWheelChanged">
                    <Image
                        x:Name="RemoteImage"
                        Stretch="Uniform"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
